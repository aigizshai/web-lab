{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

  "baseUrl": "./src",    
    "paths": {
      "@models/*": ["./models/*"],
      "@routes/*": ["./routes/*"],
      "@configs/*": ["./configs/*"],
      "@middlewares/*": ["./middlewares/*"],
      "@swagger/*": ["./swagger/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "node",
    //"ignoreDeprecations": "6.0"

  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}